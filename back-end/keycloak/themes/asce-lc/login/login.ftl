<#import "template.ftl" as layout>
<@layout.registrationLayout displayMessage=!messagesPerField.existsError('username','password') displayInfo=false; section>
<#if section = "header"><#elseif section = "form">
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="icon" type="image/png" href="data:image/png;base64,"/>
<link rel="shortcut icon" type="image/png" href="data:image/png;base64,"/>
<title>ASCE-LC · Connexion</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

/* ── Cache TOUT ce qui vient de Keycloak ── */
#kc-header,#kc-header-wrapper,
.login-pf-header,#kc-page-title,
.pf-c-login__header,.pf-c-login__main-header,
h1#kc-page-title,
.login-pf-page > div > .card-pf > .login-pf-header,
.pf-c-login__main-header h1,
.pf-c-login__main-footer,
.pf-c-login__main-footer-band,
header.pf-c-login__header,
.pf-c-page__header,
[id="kc-header"],[id="kc-header-wrapper"]{
  display:none!important;
  visibility:hidden!important;
  height:0!important;
  overflow:hidden!important;
  margin:0!important;
  padding:0!important;
}

html,body{
  height:100vh;
  width:100vw;
  overflow:hidden!important;
  font-family:'Outfit',sans-serif;
  background:#f8fafc!important;
  margin:0!important;
  padding:0!important;
}

/* ── Reset total du layout Keycloak ── */
*{box-sizing:border-box}
body,.login-pf,.login-pf-page,
.pf-c-login,.pf-c-login__container,
.pf-c-page,.pf-c-page__main,
.card-pf,.login-pf-page .card-pf,
.pf-c-login__main,.pf-c-login__main-body,
.pf-c-login__main-header,.pf-c-form,
.pf-c-login__main-footer,.pf-c-login__main-footer-band,
.container-fluid,.row,.col-sm-12,
#kc-form-wrapper,#kc-form,
section.pf-c-login{
  all:unset!important;
  display:block!important;
  width:auto!important;
  height:auto!important;
  min-height:0!important;
  max-width:none!important;
  padding:0!important;
  margin:0!important;
  background:transparent!important;
  border:none!important;
  box-shadow:none!important;
  float:none!important;
  position:static!important;
}

body{
  font-family:'Outfit',sans-serif!important;
  background:#f8fafc!important;
  height:100vh!important;
  width:100vw!important;
  overflow:hidden!important;
  padding:0!important;
  margin:0!important;
  display:block!important;
}

/* ── Layout deux colonnes ── */
.wrap{
  display:grid;
  grid-template-columns:1fr 1fr;
  width:100vw;
  height:100vh;
  border-radius:0;
  overflow:hidden;
  box-shadow:none;
  border:none;
  position:fixed;
  top:0;left:0;right:0;bottom:0;
  z-index:9999;
}

/* ══ GAUCHE ══ */
.side-img{
  position:relative;
  overflow:hidden;
  height:100vh;
}
.side-img img{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center center;
  display:block;
}
.side-img-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(
    180deg,
    rgba(5,15,8,0.15) 0%,
    rgba(10,40,20,0.10) 35%,
    rgba(5,15,8,0.75) 75%,
    rgba(3,10,5,0.92) 100%
  );
}
.side-img-top{
  position:absolute;
  top:28px;
  left:28px;
  right:28px;
}
.pill{display:none}
.pill-dot{display:none}
.img-tag{
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:rgba(255,255,255,0.12);
  border:1px solid rgba(255,255,255,0.22);
  backdrop-filter:blur(12px);
  padding:6px 16px 6px 12px;
  border-radius:100px;
  color:#fff;
  font-size:11.5px;
  font-weight:600;
  letter-spacing:.1em;
  text-transform:uppercase;
  margin-bottom:20px;
}
.img-tag-dot{
  width:7px;height:7px;
  background:#4ade80;
  border-radius:50%;
  box-shadow:0 0 0 3px rgba(74,222,128,0.25);
}
.side-img-bottom{
  position:absolute;
  bottom:0;left:0;right:0;
  padding:48px 48px 52px;
  background:none;
}
.side-img-bottom h2{
  font-size:26px;
  font-weight:700;
  color:#fff;
  line-height:1.35;
  margin-bottom:14px;
}
.gold-bar{
  width:44px;height:3px;
  background:linear-gradient(90deg,#c9a227,#f0d060);
  border-radius:2px;
  margin-bottom:12px;
}
.asce-name-box{
  display:inline-flex;
  align-items:center;
  background:rgba(201,162,39,0.18);
  border:1.5px solid rgba(201,162,39,0.55);
  border-radius:10px;
  padding:8px 22px;
  margin-bottom:14px;
}
.asce-name-box span{
  font-size:28px;
  font-weight:800;
  color:#fff;
  letter-spacing:0.12em;
  text-shadow:0 2px 8px rgba(0,0,0,0.4);
}
.side-img-bottom p{
  font-size:13px;
  color:rgba(255,255,255,0.68);
  line-height:1.65;
  max-width:320px;
}
.side-img-bottom .seal{
  display:flex;
  align-items:center;
  gap:10px;
  margin-top:20px;
  padding-top:18px;
  border-top:1px solid rgba(255,255,255,0.15);
}
.seal-icon{
  width:36px;height:36px;
  border-radius:8px;
  background:rgba(201,162,39,0.2);
  border:1px solid rgba(201,162,39,0.4);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}
.seal-icon svg{width:18px;height:18px}
.seal-text{font-size:11px;color:rgba(255,255,255,0.6);line-height:1.5}
.seal-text strong{color:rgba(255,255,255,0.85);font-weight:500;display:block}

/* ══ DROITE ══ */
.side-form{
  background:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40px 52px;
  height:100vh;
  overflow-y:auto;
  box-sizing:border-box;
}
.form-box{width:100%;max-width:420px;margin:auto;}

.logo-row{
  display:flex;align-items:center;justify-content:center;
  margin-bottom:24px;
  margin-top:0;
}
.logo-img{
  width:180px;
  height:auto;
  object-fit:contain;
  display:block;
}

.f-title{font-size:26px;font-weight:700;color:#0a2010;letter-spacing:-.03em;margin-bottom:6px}
.f-sub{font-size:13.5px;color:#64748b;line-height:1.5;margin-bottom:28px}
.f-sep{height:1px;background:#e9eef3;margin-bottom:26px}

/* Erreurs */
.err-box{
  background:#fef2f2;
  border:1px solid #fca5a5;
  border-radius:10px;
  padding:11px 14px;
  margin-bottom:18px;
  font-size:12.5px;
  color:#dc2626;
  display:flex;align-items:flex-start;gap:8px;
}
.err-box svg{width:15px;height:15px;flex-shrink:0;margin-top:1px}

/* Champs */
.field{margin-bottom:16px}
.field label{
  display:block;
  font-size:12.5px;font-weight:600;
  color:#334155;
  margin-bottom:6px;
  letter-spacing:.01em;
}
.inp-wrap{position:relative}
.inp-wrap .ico{
  position:absolute;left:13px;top:50%;
  transform:translateY(-50%);
  width:16px;height:16px;
  color:#94a3b8;pointer-events:none;
}
.inp-wrap input{
  width:100%!important;
  height:46px!important;
  padding:0 44px 0 40px!important;
  border:1.5px solid #dde3ea!important;
  border-radius:11px!important;
  font-size:13.5px!important;
  font-family:'Outfit',sans-serif!important;
  color:#1e293b!important;
  background:#f7f9fb!important;
  outline:none!important;
  transition:border-color .18s,box-shadow .18s,background .18s!important;
}
.inp-wrap input::placeholder{color:#b0bbc9!important}
.inp-wrap input:focus{
  border-color:#1a6b3c!important;
  background:#fff!important;
  box-shadow:0 0 0 3px rgba(26,107,60,0.1)!important;
}
.eye-btn{
  position:absolute;right:12px;top:50%;
  transform:translateY(-50%);
  background:none;border:none;cursor:pointer;
  color:#94a3b8;padding:4px;
  display:flex;align-items:center;
  transition:color .15s;
}
.eye-btn:hover{color:#1a6b3c}
.eye-btn svg{width:16px;height:16px}

/* Options row */
.opts{
  display:flex;align-items:center;
  justify-content:space-between;
  margin:4px 0 26px;
}
.rem-label{
  display:flex;align-items:center;gap:7px;
  font-size:12.5px;color:#64748b;
  cursor:pointer;user-select:none;
}
.rem-label input{
  accent-color:#1a6b3c;
  width:15px!important;height:15px!important;
  cursor:pointer;
}
.fgt{
  font-size:12.5px;color:#1a6b3c!important;
  font-weight:500;text-decoration:none!important;
}
.fgt:hover{color:#0f4a28!important;text-decoration:underline!important}

/* Bouton */
#kc-login,input[type=submit]#kc-login{
  width:100%!important;
  height:48px!important;
  background:linear-gradient(135deg,#1a6b3c 0%,#25834a 100%)!important;
  color:#fff!important;
  border:none!important;
  border-radius:11px!important;
  font-size:13.5px!important;
  font-weight:700!important;
  font-family:'Outfit',sans-serif!important;
  cursor:pointer!important;
  letter-spacing:.07em!important;
  text-transform:uppercase!important;
  transition:all .2s!important;
  box-shadow:0 4px 16px rgba(26,107,60,0.38)!important;
}
#kc-login:hover{
  background:linear-gradient(135deg,#0f4a28 0%,#1a6b3c 100%)!important;
  box-shadow:0 6px 22px rgba(26,107,60,0.48)!important;
  transform:translateY(-1px)!important;
}
#kc-login:active{transform:translateY(0)!important}

/* Note sécurité */
.sec-note{
  display:flex;align-items:center;justify-content:center;
  gap:6px;margin-top:20px;
  font-size:11.5px;color:#94a3b8;
}
.sec-note svg{width:12px;height:12px;color:#22c55e}

/* Barre dorée en haut */
.wrap::before{
  content:'';
  position:absolute;
  top:0;left:0;right:0;
  height:4px;
  background:linear-gradient(90deg,#c9a227,#f0d060,#c9a227);
  z-index:10;
}

@media(max-width:700px){
  .wrap{grid-template-columns:1fr}
  .side-img{display:none}
  .side-form{padding:36px 24px}
}
</style>
</head>
<body>
<div class="wrap" style="position:relative">

  <!-- ═══ GAUCHE : IMAGE ═══ -->
  <div class="side-img">
    <img src="data:image/png;base64," alt="Siège ASCE-LC"/>
    <div class="side-img-overlay"></div>



    <div class="side-img-bottom">
      <h2>Autorité Supérieure de Contrôle d'État et de Lutte contre la Corruption</h2>
      <div class="gold-bar"></div>
      <div class="seal">
        <div class="seal-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#c9a227" stroke-width="2">
            <path d="M12 2l-9 4.5V12c0 5.25 3.84 9.74 9 11 5.16-1.26 9-5.75 9-11V6.5L12 2z"/>
            <path d="M9 12l2 2 4-4" stroke="#f0d060"/>
          </svg>
        </div>
        <div class="seal-text">
          <strong>Système certifié sécurisé</strong>
          Numéro vert : 80 00 11 57
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ DROITE : FORMULAIRE ═══ -->
  <div class="side-form">
    <div class="form-box">

      <div class="logo-row">
        <img src="data:image/png;base64," alt="ASCE-LC" class="logo-img"/>
      </div>

      <div class="f-title">Bienvenue</div>
      <div class="f-sub">Connectez-vous à votre compte pour continuer</div>
      <div class="f-sep"></div>

      <#if message?has_content && message.type == 'error'>
        <div class="err-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          ${kcSanitize(message.summary)?no_esc}
        </div>
      </#if>

      <form id="kc-form-login" action="${url.loginAction}" method="post">

        <div class="field">
          <label for="username">
            <#if !realm.loginWithEmailAllowed>Identifiant
            <#elseif !realm.registrationEmailAsUsername>Identifiant ou e-mail
            <#else>Adresse e-mail</#if>
          </label>
          <div class="inp-wrap">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="8" r="4"/>
              <path d="M4 20c0-4 3.58-7 8-7s8 3 8 7"/>
            </svg>
            <input tabindex="1" id="username" name="username" type="text"
                   autocomplete="off" autofocus
                   value="${(login.username!'')}"
                   placeholder="Entrez votre identifiant"/>
          </div>
        </div>

        <div class="field">
          <label for="password">Mot de passe</label>
          <div class="inp-wrap">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="11" width="18" height="11" rx="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <input tabindex="2" id="password" name="password" type="password"
                   autocomplete="off"
                   placeholder="Entrez votre mot de passe"/>
            <button class="eye-btn" type="button" id="eye-toggle">
              <svg id="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="opts">
          <#if realm.rememberMe && !usernameEditDisabled??>
            <label class="rem-label">
              <input tabindex="3" id="rememberMe" name="rememberMe" type="checkbox"
                     <#if login.rememberMe??>checked</#if>>
              Se souvenir de moi
            </label>
          <#else><span></span></#if>

          <#if realm.resetPasswordAllowed>
            <a tabindex="5" class="fgt" href="${url.loginResetCredentialsUrl}">
              Mot de passe oublié ?
            </a>
          </#if>
        </div>

        <div id="kc-form-buttons">
          <input type="hidden" id="id-hidden-input" name="credentialId"
                 <#if auth.selectedCredential?has_content>value="${auth.selectedCredential}"</#if>/>
          <input tabindex="4" id="kc-login" name="login" type="submit" value="SE CONNECTER"/>
        </div>

      </form>



    </div>
  </div>
</div>

<script>
document.getElementById('eye-toggle').addEventListener('click', function(){
  var inp = document.getElementById('password');
  var ico = document.getElementById('eye-icon');
  if(inp.type==='password'){
    inp.type='text';
    ico.innerHTML='<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
  }else{
    inp.type='password';
    ico.innerHTML='<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  }
});
</script>

<script>
// Override favicon - bypass Keycloak parent template
(function() {
  var b64 = 'data:image/png;base64,';
  // Remove all existing favicons
  var links = document.querySelectorAll("link[rel*='icon']");
  links.forEach(function(l) { l.parentNode.removeChild(l); });
  // Set new favicon
  var link = document.createElement('link');
  link.type = 'image/png';
  link.rel = 'shortcut icon';
  link.href = b64;
  document.head.appendChild(link);
  // Also set title
  document.title = 'ASCE-LC · Connexion';
})();
</script>
</body>
</html>
</#if>
</@layout.registrationLayout>
